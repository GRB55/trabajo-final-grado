# Solo si se usa autenticación SQL (config.yaml: bd.autenticacion = sql)
# DB_USER=
# DB_PASSWORD=

# Sal para los seudónimos de las vistas vw_demo_* (solo caracteres ASCII, sin comillas).
# Guardarla: si cambia, cambian los seudónimos.
SAL_SEUDONIMO=

# Contraseña del usuario de solo lectura bi_reader (la que usa Power BI).
# Debe cumplir la política de SQL Server: 12 o más caracteres con mayúsculas, minúsculas, números y símbolos.
BI_READER_PASSWORD=
